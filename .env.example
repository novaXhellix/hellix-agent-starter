# ==============================================================================
# Hellix Crew Environment Configuration Template
# Salin berkas ini menjadi .env dan sesuaikan nilainya dengan kebutuhan sistem.
# ==============================================================================

# --- System & Application Info ---
VITE_APP_NAME="Hellix Crew"
VITE_APP_ENV="development"
VITE_APP_VERSION="1.0.0"

# --- Branding & Assets (Single Source of Truth) ---
# Lokasi logo utama aplikasi (default: /logo.png di folder public)
VITE_APP_LOGO_PATH="/logo.png"

# --- API & Services Endpoints ---
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_API_TIMEOUT_MS=15000

# --- AI & Token Cost Rates (USD per 1,000,000 Tokens) ---
VITE_TOKEN_INPUT_RATE_PER_1M=0.15
VITE_TOKEN_OUTPUT_RATE_PER_1M=0.60

# --- Media Upload & WebP Compression Limits ---
VITE_UPLOAD_MAX_IMAGE_WIDTH=1280
VITE_UPLOAD_MAX_IMAGE_HEIGHT=1280
VITE_UPLOAD_WEBP_QUALITY=0.8
VITE_UPLOAD_MAX_FILE_SIZE_MB=10

# --- Memory & Cache Engine ---
VITE_SLIDING_WINDOW_TOKEN_LIMIT=4000
VITE_RAG_TOP_K_RESULTS=5
